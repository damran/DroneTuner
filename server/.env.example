# Bind host (use 0.0.0.0 inside Docker) and port
HOST=127.0.0.1
PORT=3001

# Data directory (SQLite DB + uploaded photos/logs). Relative to server/.
DATA_DIR=./data

# Allowed browser origin for CORS (vite dev server)
CLIENT_ORIGIN=http://localhost:5173

# Optional: built client bundle to serve at / (production / Docker). Unset by default;
# when set, resolved relative to server/. The Dockerfile sets this explicitly.
# CLIENT_DIST=../client/dist

# Ollama
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.1
